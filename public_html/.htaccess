# إعدادات Apache / LiteSpeed (Hostinger)

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # منع الوصول المباشر إلى مجلد التطبيق الداخلي والملفات المخفية
    RewriteRule ^app(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    # منع ملفات التوثيق والنسخ الاحتياطية وملفات SQL
    RewriteRule \.(md|sql|log|lock|bak|zip|ini|sh|dist)$ - [F,L,NC]
</IfModule>

# حماية إضافية إذا لم تعمل mod_rewrite
<FilesMatch "\.(md|sql|log|lock|bak|zip|ini|sh|dist)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
