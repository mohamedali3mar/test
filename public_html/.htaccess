# إعدادات Apache / LiteSpeed (Hostinger)

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # منع الوصول المباشر إلى مجلد التطبيق الداخلي (الإعدادات والمكتبات والسجلات والجلسات)
    RewriteRule ^app(/|$) - [F,L]
    # منع الملفات والمجلدات المخفية، مع السماح بـ .well-known لتجديد شهادة SSL
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
    # منع ملفات التوثيق والنسخ الاحتياطية وملفات SQL والسجلات
    RewriteRule \.(md|sql|log|lock|bak|zip|ini|sh|dist|allow)$ - [F,L,NC]
    # سكربتات الواجهة تُقدم للمستخدمين المسجلين فقط عبر index.php?r=asset، ولا تُفتح مباشرة
    RewriteRule ^assets/js/(app|twofactor)\.js$ - [F,L,NC]
</IfModule>

# حماية إضافية إذا لم تعمل mod_rewrite
<FilesMatch "\.(md|sql|log|lock|bak|zip|ini|sh|dist|allow)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>
<FilesMatch "^(app|twofactor)\.js$">
    Require all denied
</FilesMatch>

# ترويسات الأمان للصفحات يرسلها PHP. هنا للملفات الثابتة فقط حتى لا تتكرر الترويسات.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>
