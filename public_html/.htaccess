# إعدادات Apache / LiteSpeed (Hostinger)

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # منع الوصول المباشر إلى مجلد التطبيق الداخلي (الإعدادات والمكتبات والسجلات والجلسات)
    RewriteRule ^app(/|$) - [F,L]
    # منع الملفات والمجلدات المخفية، مع السماح بـ .well-known لتجديد شهادة SSL
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
    # منع ملفات التوثيق والنسخ الاحتياطية والأرشيفات وملفات SQL والسجلات والملفات المؤقتة للمحررات
    # (مثل backup.sql.gz و backup.sql.bz2 و index.php.old و config.php~)
    RewriteRule (\.(md|sql|log|lock|bak|zip|ini|sh|dist|allow|gz|tgz|bz2|xz|zst|tar|7z|rar|old|orig|swp|tmp|backup|bkp)|~)$ - [F,L,NC]
    # سكربتات الواجهة تُقدم للمستخدمين المسجلين فقط عبر index.php?r=asset، ولا تُفتح مباشرة
    RewriteRule ^assets/js/[^/]+\.js$ - [F,L,NC]
</IfModule>

# حماية إضافية إذا لم تعمل mod_rewrite
# ملفات إعدادات PHP مثل .user.ini و php.ini محظورة مرتين: بقاعدة الامتداد ini وبقاعدة الملفات المخفية.
<FilesMatch "(?i)(\.(md|sql|log|lock|bak|zip|ini|sh|dist|allow|gz|tgz|bz2|xz|zst|tar|7z|rar|old|orig|swp|tmp|backup|bkp)|~)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>
<FilesMatch "^(app|twofactor|payment|tables)\.js$">
    Require all denied
</FilesMatch>

# ترويسات الأمان للصفحات يرسلها PHP. هنا للملفات الثابتة فقط حتى لا تتكرر الترويسات.
# صفحات PHP لا تطابق هذا النمط فتبقى Cache-Control عليها no-store, private كما يرسلها PHP.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2)$">
        Header set X-Content-Type-Options "nosniff"
        # روابط CSS و JS تحمل ?v=APP_VERSION فيتغير الرابط مع كل إصدار، والخطوط لا تتغير
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

# بديل فقط إذا لم تتوفر mod_headers، حتى لا تُرسل Cache-Control مرتين
<IfModule !mod_headers.c>
    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresByType font/woff2 "access plus 1 year"
        ExpiresByType text/css "access plus 1 year"
        ExpiresByType application/javascript "access plus 1 year"
        ExpiresByType text/javascript "access plus 1 year"
    </IfModule>
</IfModule>

# ضغط الردود النصية. الخطوط woff2 مضغوطة أصلًا فلا تُضغط مرة أخرى.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json image/svg+xml
    </IfModule>
</IfModule>
